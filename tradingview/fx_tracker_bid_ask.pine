//@version=6
// FX tracker: sends the live EUR/USD price to your app about once a minute.
//
// Works on any timeframe:
//   - 1-tick ("1T") chart: sends "bid" and "ask"; the app stores their average
//     as the mid. TradingView only provides bid/ask on 1T charts, which not
//     every plan includes.
//   - Any other chart (1 second, 1 minute, ...): sends the chart's latest price
//     as "price". Whether that's a mid or a bid depends on the data feed; turn
//     on Bid and Ask lines in Chart settings to check.
//
// Setup (details in the repo README, "Market mid from TradingView"):
//   1. Pine Editor -> paste this script -> Save -> Add to chart (EURUSD).
//   2. Hover over the script's label at the top-left of the chart -> gear icon
//      -> Inputs -> paste your TRADINGVIEW_WEBHOOK_SECRET.
//   3. Create alert -> Condition: this script, "Any alert() function call"
//      -> Notifications: Webhook URL = https://YOUR-APP.vercel.app/api/tradingview/webhook
//      Leave the Message box alone; the script writes the message.
// Keep the script private (don't publish it) since its settings hold your secret.

indicator("FX tracker: bid/ask webhook", overlay = true)

secret    = input.string("", "Webhook secret (TRADINGVIEW_WEBHOOK_SECRET)")
everySecs = input.int(60, "Send at most once every (seconds)", minval = 10)

// varip keeps its value across realtime updates, so the throttle survives them.
varip int lastSent = 0

if barstate.isrealtime and timenow - lastSent >= everySecs * 1000
    hasBidAsk = not na(bid) and not na(ask)
    msg = '{"secret": "' + secret + '", "ticker": "' + syminfo.ticker + '"'
    if hasBidAsk
        msg := msg + ', "bid": ' + str.tostring(bid, "#.########")
        msg := msg + ', "ask": ' + str.tostring(ask, "#.########")
    else
        msg := msg + ', "price": ' + str.tostring(close, "#.########")
    msg := msg + ', "source": "' + (hasBidAsk ? "bid_ask" : "chart_close") + '"'
    msg := msg + ', "time": "' + str.tostring(timenow) + '"}'
    lastSent := timenow
    alert(msg, alert.freq_all)

// Indicators need at least one output; this one draws nothing.
plot(na, "unused", display = display.none)
